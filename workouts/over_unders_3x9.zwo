<workout_file>
    <author>Groove</author>
    <name>Over-Unders 3x9</name>
    <description>Three nine-minute blocks alternating two minutes under threshold with one minute over. Teaches the legs to clear lactate while still working.</description>
    <sportType>bike</sportType>
    <tags></tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80"/>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08">
            <textevent timeoffset="2" message="Over. One minute, then straight back under without stopping."/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08"/>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08"/>
        <SteadyState Duration="300" Power="0.50">
            <textevent timeoffset="5" message="Block one done. Two to go."/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08"/>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08"/>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08"/>
        <SteadyState Duration="300" Power="0.50"/>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08"/>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08"/>
        <SteadyState Duration="120" Power="0.92"/>
        <SteadyState Duration="60" Power="1.08">
            <textevent timeoffset="2" message="Last over. Then it is all downhill."/>
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40"/>
    </workout>
</workout_file>
