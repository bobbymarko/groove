; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Groove"
config/custom_user_dir_name="Groove"
config/icon="res://assets/images/app-icon.png"
run/main_scene="res://ui/screens/home_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

App="*res://app/app.gd"
Devices="*res://devices/device_manager.gd"
Sync="*res://connectors/upload_queue.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[shader_globals]

cel_shade_band={
"type": "float",
"value": 0.66
}
cel_dark_band={
"type": "float",
"value": 0.5
}
cel_shadow_band={
"type": "float",
"value": 0.45
}
cel_speckle={
"type": "float",
"value": 0.12
}
cel_highlight={
"type": "float",
"value": 0.15
}
cel_bands={
"type": "float",
"value": 3.0
}
cel_colorize_steps={
"type": "float",
"value": 3.0
}
cel_texture_mix={
"type": "float",
"value": 0.0
}
cel_prop_snow={
"type": "float",
"value": 0.78
}
cel_smooth_terrain={
"type": "float",
"value": 0.0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
