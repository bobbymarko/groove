; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Groove"
config/version="0.0.6"
config/custom_user_dir_name="Groove"
config/icon="res://assets/images/app-icon.png"
run/main_scene="res://ui/screens/home_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

App="*res://app/app.gd"
Devices="*res://devices/device_manager.gd"
Sync="*res://connectors/upload_queue.gd"
Updates="*res://core/update/updater.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[shader_globals]

water_sky={
"type": "vec3",
"value": Vector3(0.5, 0.62, 0.8)
}
sun_dir={
"type": "vec3",
"value": Vector3(0, 0.6, 0.8)
}

eye_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

rain_wet={
"type": "float",
"value": 0.0
}

shade_near={
"type": "sampler2D",
"value": ""
}
shade_far={
"type": "sampler2D",
"value": ""
}
shade_cloud={
"type": "sampler2D",
"value": ""
}
shade_near_at={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
shade_far_at={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
shade_cloud_at={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
shade_amount={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
shade_trees={
"type": "vec4",
"value": Vector4(0, 0, 100000, 100000)
}

cel_shade_band={
"type": "float",
"value": 0.66
}
cel_dark_band={
"type": "float",
"value": 0.5
}
cel_shadow_band={
"type": "float",
"value": 0.45
}
cel_speckle={
"type": "float",
"value": 0.12
}
cel_highlight={
"type": "float",
"value": 0.15
}
cel_bands={
"type": "float",
"value": 3.0
}
cel_colorize_steps={
"type": "float",
"value": 3.0
}
cel_texture_mix={
"type": "float",
"value": 0.0
}
cel_prop_snow={
"type": "float",
"value": 0.78
}
cel_smooth_terrain={
"type": "float",
"value": 0.0
}

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
